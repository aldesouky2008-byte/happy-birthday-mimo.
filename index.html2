<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>كل سنة وانتي طيبة يا ميمو ♥️🦋</title>
    <!-- Google Fonts: Cairo & Tajawal -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Canvas Confetti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        cairo: ['Cairo', 'sans-serif'],
                        tajawal: ['Tajawal', 'sans-serif'],
                    },
                    colors: {
                        blushBg: '#fff5f8',
                        pinkMist: '#ffe4ee',
                        roseSoft: '#ffb3ce',
                        pinkPrimary: '#ff4d8d',
                        pinkDeep: '#e11d68',
                        roseText: '#591c34',
                        mutedRose: '#8f4f68',
                    }
                }
            }
        }
    </script>

    <style>
        * {
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            font-family: 'Cairo', sans-serif;
            background: linear-gradient(135deg, #fff5f8 0%, #ffe6f0 45%, #ffd6e6 100%);
            color: #4a152b;
            overflow-x: hidden;
            margin: 0;
            padding: 0;
            min-height: 100vh;
        }

        /* Custom Pink Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #fff0f5;
        }
        ::-webkit-scrollbar-thumb {
            background: #ff7aa8;
            border-radius: 9999px;
        }

        /* Soft Romantic Pastel Background */
        .bg-pastel-pink {
            background: radial-gradient(circle at 20% 15%, #ffffff 0%, #ffe9f2 45%, #ffd4e5 100%);
        }

        /* Graceful Butterfly Entrance Flight */
        @keyframes butterflyGlideIn {
            0% {
                transform: translate(-38vw, 38vh) scale(0.35) rotate(-25deg);
                opacity: 0;
            }
            35% {
                transform: translate(18vw, 14vh) scale(0.7) rotate(16deg);
                opacity: 1;
            }
            70% {
                transform: translate(-10vw, -8vh) scale(0.92) rotate(-10deg);
            }
            100% {
                transform: translate(0, 0) scale(1) rotate(0deg);
                opacity: 1;
            }
        }

        /* Gentle Organic Floating After Landing */
        @keyframes gentleHover {
            0%, 100% {
                transform: translateY(0px) rotate(0deg);
            }
            50% {
                transform: translateY(-12px) rotate(1.5deg);
            }
        }

        /* Smooth Natural Wing Flapping (No harsh flattening) */
        @keyframes wingFlutterLeft {
            0%, 100% {
                transform: rotateY(0deg) skewY(0deg);
            }
            50% {
                transform: rotateY(42deg) skewY(3deg);
            }
        }

        @keyframes wingFlutterRight {
            0%, 100% {
                transform: rotateY(0deg) skewY(0deg);
            }
            50% {
                transform: rotateY(-42deg) skewY(-3deg);
            }
        }

        .butterfly-entrance {
            animation: butterflyGlideIn 3.2s cubic-bezier(0.22, 1, 0.36, 1) forwards;
            perspective: 1100px;
        }

        .butterfly-float {
            animation: gentleHover 3.4s ease-in-out infinite;
            transform-style: preserve-3d;
        }

        .wing-left-group {
            transform-origin: 180px 150px;
            animation: wingFlutterLeft 0.55s ease-in-out infinite;
        }

        .wing-right-group {
            transform-origin: 180px 150px;
            animation: wingFlutterRight 0.55s ease-in-out infinite;
        }

        .landed .wing-left-group {
            animation: wingFlutterLeft 1.4s ease-in-out infinite;
        }

        .landed .wing-right-group {
            animation: wingFlutterRight 1.4s ease-in-out infinite;
        }

        /* Soft Pink Pulse on Entrance Button */
        @keyframes softPinkPulse {
            0%, 100% {
                box-shadow: 0 10px 28px rgba(255, 77, 141, 0.32), 0 0 0 0 rgba(255, 117, 168, 0.45);
                transform: scale(1);
            }
            50% {
                box-shadow: 0 14px 36px rgba(255, 77, 141, 0.48), 0 0 0 10px rgba(255, 117, 168, 0);
                transform: scale(1.025);
            }
        }

        .pink-cta-glow {
            animation: softPinkPulse 2.4s infinite ease-in-out;
        }

        /* Sound Wave Equalizer Bars */
        @keyframes waveBounce {
            0%, 100% { height: 25%; }
            50% { height: 100%; }
        }
        .music-active .w-bar-1 { animation: waveBounce 0.6s ease-in-out infinite; }
        .music-active .w-bar-2 { animation: waveBounce 0.45s ease-in-out infinite 0.15s; }
        .music-active .w-bar-3 { animation: waveBounce 0.7s ease-in-out infinite 0.25s; }

        /* Card Stagger Reveal */
        .fade-up-card {
            opacity: 0;
            transform: translateY(22px);
            transition: opacity 0.75s cubic-bezier(0.16, 1, 0.3, 1), transform 0.75s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .fade-up-card.show {
            opacity: 1;
            transform: translateY(0);
        }

        /* Floating Hearts & Petals */
        @keyframes floatHeartUp {
            0% {
                transform: translateY(105vh) scale(0.65) rotate(-10deg);
                opacity: 0;
            }
            15% {
                opacity: 0.85;
            }
            85% {
                opacity: 0.75;
            }
            100% {
                transform: translateY(-12vh) scale(1.1) rotate(18deg);
                opacity: 0;
            }
        }

        .ambient-heart {
            position: fixed;
            pointer-events: none;
            z-index: 1;
            animation: floatHeartUp linear infinite;
        }

        /* Light White & Blush Glass Card */
        .blush-glass-card {
            background: rgba(255, 255, 255, 0.84);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1.5px solid rgba(255, 143, 184, 0.45);
            box-shadow: 0 14px 35px -10px rgba(235, 87, 142, 0.18), 0 4px 12px rgba(255, 182, 208, 0.25);
        }

        /* Burst Butterfly Flight Animation */
        @keyframes burstButterflyFly {
            0% {
                transform: translate(0, 0) scale(0.4) rotate(0deg);
                opacity: 0;
            }
            15% {
                opacity: 1;
            }
            50% {
                transform: translate(var(--tx-mid), var(--ty-mid)) scale(1.05) rotate(var(--rot-mid));
                opacity: 1;
            }
            100% {
                transform: translate(var(--tx-end), var(--ty-end)) scale(0.85) rotate(var(--rot-end));
                opacity: 0;
            }
        }

        .burst-butterfly {
            position: fixed;
            pointer-events: none;
            z-index: 60;
            animation: burstButterflyFly var(--dur, 3.2s) cubic-bezier(0.22, 1, 0.36, 1) forwards;
            filter: drop-shadow(0 6px 12px rgba(255, 77, 141, 0.3));
        }

        @keyframes messagePopIn {
            0% {
                opacity: 0;
                transform: translateY(10px) scale(0.96);
            }
            100% {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .message-pop {
            animation: messagePopIn 0.45s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
    </style>
</head>
<body class="bg-pastel-pink text-roseText selection:bg-pinkPrimary selection:text-white">

    <!-- Floating Pink Hearts & Sparkles Background -->
    <div id="hearts-bg-container" class="fixed inset-0 pointer-events-none overflow-hidden z-0"></div>

    <!-- YouTube Player Container for Ramy Sabry - Kol Sana (1UYuD_UUoFY) -->
    <!-- Kept off-screen with 200x200 dimensions and playsinline=1 so mobile browsers allow immediate audio autoplay on click -->
    <div id="yt-audio-container" class="fixed -top-[300px] -left-[300px] w-[200px] h-[200px] opacity-0 pointer-events-none overflow-hidden z-0" aria-hidden="true">
        <div id="ramy-sabry-player"></div>
    </div>

    <!-- ========================================================= -->
    <!-- SCREEN 1: ELEGANT BUTTERFLY ENTRANCE                      -->
    <!-- ========================================================= -->
    <section id="intro-screen" class="fixed inset-0 z-50 flex flex-col items-center justify-center p-5 bg-pastel-pink transition-all duration-1000 ease-in-out">
        
        <p id="welcome-whisper" class="text-mutedRose font-semibold text-sm sm:text-base mb-4 opacity-0 transition-opacity duration-700">
            ✨ مفاجأة صغيرة لـ ميمو ✨
        </p>

        <div id="butterfly-entrance" class="butterfly-entrance relative flex flex-col items-center justify-center max-w-md w-full">
            <div id="butterfly-float" class="butterfly-float relative flex flex-col items-center">
                
                <!-- High-Detail Elegant Monarch/Swallowtail-Inspired Pink & Pearl Butterfly SVG -->
                <div class="relative w-72 h-60 sm:w-80 sm:h-68 flex items-center justify-center drop-shadow-[0_16px_28px_rgba(255,77,141,0.32)]">
                    <svg viewBox="0 0 360 300" class="w-full h-full overflow-visible">
                        <defs>
                            <!-- Soft Pastel to Vibrant Rose Wing Gradients -->
                            <radialGradient id="forewingGrad" cx="35%" cy="40%" r="75%">
                                <stop offset="0%" stop-color="#ffffff" />
                                <stop offset="30%" stop-color="#ffc2d9" />
                                <stop offset="72%" stop-color="#ff669e" />
                                <stop offset="100%" stop-color="#e11d68" />
                            </radialGradient>

                            <radialGradient id="hindwingGrad" cx="45%" cy="35%" r="75%">
                                <stop offset="0%" stop-color="#fff0f6" />
                                <stop offset="45%" stop-color="#ff9ec2" />
                                <stop offset="88%" stop-color="#ff4d8d" />
                                <stop offset="100%" stop-color="#d81b60" />
                            </radialGradient>

                            <linearGradient id="wingRimGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#ffffff" />
                                <stop offset="50%" stop-color="#ffe0ec" />
                                <stop offset="100%" stop-color="#ff85b3" />
                            </linearGradient>

                            <linearGradient id="bodyGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                                <stop offset="0%" stop-color="#ff85b3" />
                                <stop offset="50%" stop-color="#d81b60" />
                                <stop offset="100%" stop-color="#ff85b3" />
                            </linearGradient>
                        </defs>

                        <!-- LEFT WINGS -->
                        <g class="wing-left-group">
                            <!-- Upper Left Forewing (Delicate curved silhouette) -->
                            <path d="M176,142 C145,75 68,24 30,52 C4,71 14,116 58,136 C96,153 142,152 176,148 Z"
                                  fill="url(#forewingGrad)" stroke="url(#wingRimGrad)" stroke-width="3" stroke-linejoin="round" />
                            
                            <!-- Delicate Wing Veins & Pearlescent Accents (Left Upper) -->
                            <path d="M172,144 C132,110 82,78 42,64" fill="none" stroke="#ffffff" stroke-width="1.3" opacity="0.65" />
                            <path d="M172,145 C124,126 76,112 36,96" fill="none" stroke="#ffffff" stroke-width="1.2" opacity="0.55" />
                            <path d="M168,146 C125,138 88,134 58,124" fill="none" stroke="#ffffff" stroke-width="1.1" opacity="0.5" />
                            
                            <!-- Soft Glowing Wing Spots -->
                            <ellipse cx="44" cy="64" rx="7" ry="4.5" transform="rotate(-25 44 64)" fill="#ffffff" opacity="0.85" />
                            <ellipse cx="36" cy="82" rx="5.5" ry="3.5" transform="rotate(-15 36 82)" fill="#ffffff" opacity="0.75" />
                            <circle cx="44" cy="102" r="3.5" fill="#ffffff" opacity="0.7" />
                            <circle cx="62" cy="54" r="3.5" fill="#fff0f6" opacity="0.8" />

                            <!-- Lower Left Hindwing (Graceful rounded petal shape) -->
                            <path d="M176,150 C134,152 68,168 62,208 C57,242 94,264 128,248 C154,236 168,195 177,158 Z"
                                  fill="url(#hindwingGrad)" stroke="url(#wingRimGrad)" stroke-width="2.8" stroke-linejoin="round" />
                            
                            <!-- Delicate Wing Veins & Pearls (Left Lower) -->
                            <path d="M173,154 C142,182 110,214 96,242" fill="none" stroke="#ffffff" stroke-width="1.2" opacity="0.55" />
                            <path d="M174,152 C132,170 94,186 72,204" fill="none" stroke="#ffffff" stroke-width="1.2" opacity="0.55" />
                            <circle cx="78" cy="214" r="4.5" fill="#ffffff" opacity="0.8" />
                            <circle cx="92" cy="232" r="4" fill="#ffffff" opacity="0.75" />
                            <circle cx="112" cy="240" r="3.5" fill="#ffffff" opacity="0.7" />
                        </g>

                        <!-- RIGHT WINGS (Mirrored Symmetry) -->
                        <g class="wing-right-group">
                            <!-- Upper Right Forewing -->
                            <path d="M184,142 C215,75 292,24 330,52 C356,71 346,116 302,136 C264,153 218,152 184,148 Z"
                                  fill="url(#forewingGrad)" stroke="url(#wingRimGrad)" stroke-width="3" stroke-linejoin="round" />
                            
                            <!-- Delicate Wing Veins & Pearlescent Accents (Right Upper) -->
                            <path d="M188,144 C228,110 278,78 318,64" fill="none" stroke="#ffffff" stroke-width="1.3" opacity="0.65" />
                            <path d="M188,145 C236,126 284,112 324,96" fill="none" stroke="#ffffff" stroke-width="1.2" opacity="0.55" />
                            <path d="M192,146 C235,138 272,134 302,124" fill="none" stroke="#ffffff" stroke-width="1.1" opacity="0.5" />

                            <!-- Soft Glowing Wing Spots -->
                            <ellipse cx="316" cy="64" rx="7" ry="4.5" transform="rotate(25 316 64)" fill="#ffffff" opacity="0.85" />
                            <ellipse cx="324" cy="82" rx="5.5" ry="3.5" transform="rotate(15 324 82)" fill="#ffffff" opacity="0.75" />
                            <circle cx="316" cy="102" r="3.5" fill="#ffffff" opacity="0.7" />
                            <circle cx="298" cy="54" r="3.5" fill="#fff0f6" opacity="0.8" />

                            <!-- Lower Right Hindwing -->
                            <path d="M184,150 C226,152 292,168 298,208 C303,242 266,264 232,248 C206,236 192,195 183,158 Z"
                                  fill="url(#hindwingGrad)" stroke="url(#wingRimGrad)" stroke-width="2.8" stroke-linejoin="round" />

                            <!-- Delicate Wing Veins & Pearls (Right Lower) -->
                            <path d="M187,154 C218,182 250,214 264,242" fill="none" stroke="#ffffff" stroke-width="1.2" opacity="0.55" />
                            <path d="M186,152 C228,170 266,186 288,204" fill="none" stroke="#ffffff" stroke-width="1.2" opacity="0.55" />
                            <circle cx="282" cy="214" r="4.5" fill="#ffffff" opacity="0.8" />
                            <circle cx="268" cy="232" r="4" fill="#ffffff" opacity="0.75" />
                            <circle cx="248" cy="240" r="3.5" fill="#ffffff" opacity="0.7" />
                        </g>

                        <!-- BUTTERFLY BODY & CURVED ANTENNAE -->
                        <g>
                            <!-- Left Antenna -->
                            <path d="M178,118 Q164,84 148,78" fill="none" stroke="#e11d68" stroke-width="2.2" stroke-linecap="round" />
                            <circle cx="147" cy="78" r="3" fill="#ff4d8d" />
                            <!-- Right Antenna -->
                            <path d="M182,118 Q196,84 212,78" fill="none" stroke="#e11d68" stroke-width="2.2" stroke-linecap="round" />
                            <circle cx="213" cy="78" r="3" fill="#ff4d8d" />

                            <!-- Slender Body -->
                            <rect x="175.5" y="116" width="9" height="74" rx="4.5" fill="url(#bodyGrad)" stroke="#ffffff" stroke-width="1.2" />
                            <!-- Head -->
                            <circle cx="180" cy="114" r="5.5" fill="#e11d68" stroke="#ffffff" stroke-width="1.2" />
                        </g>
                    </svg>
                </div>

                <!-- Interactive Entrance Button Integrated Right Below/With the Butterfly -->
                <div id="butterfly-btn-wrapper" class="opacity-0 translate-y-4 pointer-events-none transition-all duration-700 ease-out -mt-5 z-10 w-full px-3 flex flex-col items-center">
                    <button id="enter-btn" onclick="openBirthdayPage()" 
                        class="pink-cta-glow group relative overflow-hidden rounded-3xl bg-gradient-to-l from-pinkDeep via-pinkPrimary to-[#ff7aa8] px-7 py-4 text-white shadow-xl cursor-pointer focus:outline-none active:scale-95 transition-transform w-full max-w-sm border-2 border-white/80">
                        <div class="flex flex-col items-center justify-center gap-1">
                            <span class="font-extrabold text-lg sm:text-xl leading-snug text-center drop-shadow-sm">
                                كل سنه وانتي طيبه ي احلا اخت ف الدنيااا
                            </span>
                            <span class="text-white/95 text-xs sm:text-sm font-medium flex items-center gap-1.5 mt-0.5 bg-white/20 px-3 py-0.5 rounded-full">
                                <span>اضغطي هنا يا ميمو</span>
                                <span class="inline-block animate-bounce">✨</span>
                            </span>
                        </div>
                    </button>
                </div>

            </div>
        </div>
    </section>

    <!-- ========================================================= -->
    <!-- COMPACT TOP CORNER MUTE/UNMUTE ICON BUTTON                -->
    <!-- ========================================================= -->
    <div id="floating-music-pill" class="fixed top-4 left-4 z-40 -translate-y-20 opacity-0 transition-all duration-700">
        <button id="music-toggle-btn" onclick="toggleSongPlayback()" aria-label="كتم أو تشغيل الصوت" title="التحكم في الصوت"
            class="flex items-center justify-center w-11 h-11 rounded-full bg-white/90 backdrop-blur-md border-2 border-roseSoft shadow-[0_8px_20px_rgba(225,29,104,0.2)] text-pinkDeep hover:bg-pinkMist active:scale-95 transition-all cursor-pointer">
            <!-- Sound On Icon (Default when playing) -->
            <svg id="icon-sound-on" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
            </svg>
            <!-- Sound Muted Icon -->
            <svg id="icon-sound-off" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                <line x1="23" y1="9" x2="17" y2="15"></line>
                <line x1="17" y1="9" x2="23" y2="15"></line>
            </svg>
        </button>
    </div>

    <!-- ========================================================= -->
    <!-- SCREEN 2: MAIN BIRTHDAY MESSAGE (SOFT PINK & WHITE)       -->
    <!-- ========================================================= -->
    <main id="celebration-screen" class="hidden opacity-0 transition-opacity duration-1000 relative z-10 pb-24 pt-12 sm:pt-14 px-4 sm:px-6 max-w-2xl mx-auto">
        <!-- Paragraph Card 1: Funny Besties Shenanigans -->
        <article class="fade-up-card blush-glass-card rounded-3xl p-6 sm:p-8 mb-5 border-r-4 border-r-pinkPrimary">
            <div class="flex items-center gap-2.5 mb-3.5">
                <span class="w-9 h-9 rounded-2xl bg-pinkMist border border-roseSoft flex items-center justify-center text-lg">😂</span>
                <h2 class="text-pinkDeep font-extrabold text-base sm:text-lg">شريكة المصايب والجنان</h2>
            </div>
            <div class="space-y-3.5 text-roseText text-base sm:text-lg leading-relaxed font-tajawal font-medium">
                <p>
                    اكتر حد بحبو ف حياتي عارفه كل البلاوي بتعتي و كل ما اجي اعمل مصيبه اقولك ف ثانيه عشان تشجعيني اعملها 😂😂
                </p>
                <p class="text-pinkDeep font-bold">
                    فكك المهم كل سنه وانتي طيبه و يرب السنه الجايه اللي ف بالي انا وانتي يولع 😂
                </p>
                <p class="text-mutedRose font-semibold">
                    كل سنه و انا مزهقك ف اختيارات تعر 🙈😂
                </p>
            </div>
        </article>

        <!-- Paragraph Card 2: Safe Space & Understanding -->
        <article class="fade-up-card blush-glass-card rounded-3xl p-6 sm:p-8 mb-5 border-r-4 border-r-[#ff85b3]">
            <div class="flex items-center gap-2.5 mb-3.5">
                <span class="w-9 h-9 rounded-2xl bg-pinkMist border border-roseSoft flex items-center justify-center text-lg">🤍</span>
                <h2 class="text-pinkDeep font-extrabold text-base sm:text-lg">المكان الآمن</h2>
            </div>
            <p class="text-roseText text-base sm:text-lg leading-loose font-tajawal font-medium">
                بجد وجودك في حياتي بيفرق في كل تفصيلة، وأكتر حد بيفهمني من غير ما أتكلم وبيستحمل جناني وقراراتي اللي بتودي في داهية دايماً. مهما الدنيا لفت أو انشغلنا، بتفضلي إنتي المكان الآمن والضحكة اللي بتهون أي ضغط أو تعب
            </p>
        </article>

        <!-- Paragraph Card 3: Heartfelt Wishes & Grand Signature -->
        <article class="fade-up-card blush-glass-card rounded-3xl p-6 sm:p-8 mb-7 border-r-4 border-r-pinkDeep">
            <div class="flex items-center gap-2.5 mb-3.5">
                <span class="w-9 h-9 rounded-2xl bg-pinkMist border border-roseSoft flex items-center justify-center text-lg">🤲✨</span>
                <h2 class="text-pinkDeep font-extrabold text-base sm:text-lg">دعوة من القلب ليكي</h2>
            </div>
            <p class="text-roseText text-base sm:text-lg leading-loose font-tajawal font-medium mb-6">
                يارب السنة دي تبقى وش الخير عليكي وتحققي فيها كل اللي بتتمنيه وأكتر، وتفضلي دايماً ناجحة ومبسوطة وقلبك أبيض زي ما إنتي، ونفضل دايماً سند لبعض ونكمل رحلة المصايب والضحك سوا لحد آخر العمر
            </p>

            <div class="pt-5 border-t border-roseSoft/50 text-center">
                <p class="text-xl sm:text-2xl font-black text-pinkDeep leading-relaxed">
                    كل سنه وانتي اختي و صحبتي و رووحقلبيي ♥️♥️♥️😍
                </p>
            </div>
        </article>

        <!-- Single Interactive Butterfly & Message Button Section -->
        <div class="fade-up-card flex flex-col items-center justify-center mb-10">
            <button id="butterflies-surprise-btn" onclick="triggerButterfliesAndQuote()" 
                class="w-full sm:w-auto px-7 py-4 rounded-3xl bg-gradient-to-l from-pinkDeep via-pinkPrimary to-[#ff7aa8] hover:opacity-95 text-white font-extrabold text-base sm:text-lg shadow-[0_10px_26px_rgba(255,77,141,0.38)] border-2 border-white/80 active:scale-95 transition-all flex items-center justify-center gap-2 cursor-pointer text-center">
                <span>دوسي هنا ها يطلع فراشات و كلام تحت 😂</span>
            </button>

            <!-- Dynamic Rotating Quote Box Revealed Underneath -->
            <div id="dynamic-quote-box" class="hidden w-full mt-5">
                <div id="dynamic-quote-card" class="blush-glass-card rounded-3xl p-5 sm:p-6 text-center border-2 border-roseSoft shadow-md">
                    <p id="dynamic-quote-text" class="text-pinkDeep font-extrabold text-lg sm:text-xl leading-relaxed font-cairo"></p>
                    <span id="dynamic-quote-counter" class="inline-block mt-2.5 px-3 py-0.5 rounded-full bg-pinkMist text-mutedRose text-xs font-bold"></span>
                </div>
            </div>
        </div>

    </main>

    <!-- Custom Cute Toast Notification -->
    <div id="toast-notification" class="fixed top-5 left-1/2 -translate-x-1/2 z-50 pointer-events-none opacity-0 transition-all duration-300 -translate-y-4">
        <div class="px-5 py-2.5 rounded-full bg-white/95 border-2 border-roseSoft text-pinkDeep text-sm font-extrabold shadow-lg flex items-center gap-2">
            <span id="toast-message">كل سنة وانتي طيبة يا ميمو 💖</span>
        </div>
    </div>

    <script>
        // ==========================================
        // 1. RAMY SABRY - KOL SANA YOUTUBE PLAYER
        // ==========================================
        // Official Ramy Sabry - Kol Sana (1UYuD_UUoFY)
        const RAMY_SABRY_KOL_SANA_ID = '1UYuD_UUoFY';
        let player = null;
        let playerReady = false;
        let isAudioPlaying = false;
        let pendingPlayOnReady = false;

        // Load YouTube IFrame Player API asynchronously
        const ytScript = document.createElement('script');
        ytScript.src = 'https://www.youtube.com/iframe_api';
        document.head.appendChild(ytScript);

        function onYouTubeIframeAPIReady() {
            player = new YT.Player('ramy-sabry-player', {
                height: '200',
                width: '200',
                videoId: RAMY_SABRY_KOL_SANA_ID,
                playerVars: {
                    autoplay: 0,
                    controls: 0,
                    disablekb: 1,
                    fs: 0,
                    loop: 1,
                    playlist: RAMY_SABRY_KOL_SANA_ID,
                    modestbranding: 1,
                    playsinline: 1,
                    rel: 0,
                    origin: window.location.origin
                },
                events: {
                    onReady: (e) => {
                        playerReady = true;
                        e.target.setVolume(100);
                        if (pendingPlayOnReady) {
                            e.target.unMute();
                            e.target.setVolume(100);
                            e.target.playVideo();
                            isAudioPlaying = true;
                            updateAudioButtonUI(true);
                        }
                    },
                    onStateChange: (e) => {
                        if (e.data === YT.PlayerState.PLAYING) {
                            isAudioPlaying = true;
                            updateAudioButtonUI(true);
                        } else if (e.data === YT.PlayerState.PAUSED) {
                            isAudioPlaying = false;
                            updateAudioButtonUI(false);
                        } else if (e.data === YT.PlayerState.ENDED) {
                            e.target.playVideo();
                        }
                    }
                }
            });
        }

        function startRamySabrySong() {
            pendingPlayOnReady = true;
            if (playerReady && player && typeof player.playVideo === 'function') {
                player.unMute();
                player.setVolume(100);
                player.playVideo();
                isAudioPlaying = true;
                updateAudioButtonUI(true);
            }
        }

        function toggleSongPlayback() {
            if (!playerReady || !player) return;

            if (isAudioPlaying && !player.isMuted()) {
                player.mute();
                player.pauseVideo();
                isAudioPlaying = false;
                updateAudioButtonUI(false);
            } else {
                player.unMute();
                player.setVolume(100);
                player.playVideo();
                isAudioPlaying = true;
                updateAudioButtonUI(true);
            }
        }

        function updateAudioButtonUI(playing) {
            const iconOn = document.getElementById('icon-sound-on');
            const iconOff = document.getElementById('icon-sound-off');
            if (playing) {
                iconOn.classList.remove('hidden');
                iconOff.classList.add('hidden');
            } else {
                iconOn.classList.add('hidden');
                iconOff.classList.remove('hidden');
            }
        }

        // ==========================================
        // 2. BUTTERFLY ENTRANCE & PAGE TRANSITION
        // ==========================================
        window.addEventListener('DOMContentLoaded', () => {
            spawnAmbientHearts();

            const whisper = document.getElementById('welcome-whisper');
            const floatWrap = document.getElementById('butterfly-float');
            const btnWrap = document.getElementById('butterfly-btn-wrapper');

            setTimeout(() => {
                whisper.classList.remove('opacity-0');
            }, 350);

            // Reveal button gracefully once butterfly lands in center
            setTimeout(() => {
                floatWrap.classList.add('landed');
                btnWrap.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
                btnWrap.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
            }, 2900);
        });

        function openBirthdayPage() {
            // Immediately trigger YouTube playback & unmute inside the user click event
            startRamySabrySong();

            const intro = document.getElementById('intro-screen');
            const mainPage = document.getElementById('celebration-screen');
            const musicPill = document.getElementById('floating-music-pill');

            intro.classList.add('opacity-0', 'scale-105', 'pointer-events-none');

            setTimeout(() => {
                intro.classList.add('hidden');
                mainPage.classList.remove('hidden');

                void mainPage.offsetWidth;
                mainPage.classList.remove('opacity-0');

                musicPill.classList.remove('-translate-y-20', 'opacity-0');

                const cards = document.querySelectorAll('.fade-up-card');
                cards.forEach((card, i) => {
                    setTimeout(() => {
                        card.classList.add('show');
                    }, 160 * i);
                });

                launchPinkConfetti();
            }, 600);
        }

        // ==========================================
        // 3. BUTTERFLIES BURST & ROTATING MESSAGES
        // ==========================================
        const memoSurpriseQuotes = [
            "أحلى أخت وصحبة في الدنيا كلها ربنا يديمك نعمة في حياتي ♥️🦋",
            "مفيش مصيبة بتكمل غير بيكي يا وش السعد 😂✨",
            "كل سنة وإنتي ضحكتك منورة الدنيا وقلبك أبيض زي ما هو 🌸💖",
            "مهما لفينا ورحنا بتفضلي إنتي أقرب حد لقلبي وروحي 🥰🦋",
            "السنة دي بتاعتك وهتكسري الدنيا يا ميمو يارب دايماً مبسوطة 🎉💕"
        ];
        let currentQuoteIndex = 0;

        function createPastelButterflySVG(size) {
            const palettes = [
                { c1: '#ffffff', c2: '#ffc2d9', c3: '#ff4d8d' },
                { c1: '#fff0f6', c2: '#ff9ec2', c3: '#e11d68' },
                { c1: '#ffffff', c2: '#ffd6e6', c3: '#ff7aa8' }
            ];
            const p = palettes[Math.floor(Math.random() * palettes.length)];
            return `
                <svg width="${size}" height="${Math.round(size * 0.85)}" viewBox="0 0 120 100" overflow="visible">
                    <path d="M58,48 C45,18 14,6 4,22 C-4,34 6,50 24,54 C38,57 50,53 58,50 Z" fill="${p.c2}" stroke="${p.c3}" stroke-width="2"/>
                    <path d="M58,51 C40,53 16,62 18,78 C20,92 36,96 48,86 C55,79 57,64 59,53 Z" fill="${p.c3}" stroke="${p.c1}" stroke-width="1.5"/>
                    <path d="M62,48 C75,18 106,6 116,22 C124,34 114,50 96,54 C82,57 70,53 62,50 Z" fill="${p.c2}" stroke="${p.c3}" stroke-width="2"/>
                    <path d="M62,51 C80,53 104,62 102,78 C100,92 84,96 72,86 C65,79 63,64 61,53 Z" fill="${p.c3}" stroke="${p.c1}" stroke-width="1.5"/>
                    <circle cx="24" cy="26" r="3.5" fill="${p.c1}" opacity="0.85"/>
                    <circle cx="96" cy="26" r="3.5" fill="${p.c1}" opacity="0.85"/>
                    <rect x="58.5" y="34" width="3" height="32" rx="1.5" fill="${p.c3}"/>
                </svg>
            `;
        }

        function spawnButterflyBurst(originX, originY) {
            const container = document.getElementById('hearts-bg-container');
            const count = 16;

            for (let i = 0; i < count; i++) {
                const b = document.createElement('div');
                b.className = 'burst-butterfly';
                const size = 28 + Math.floor(Math.random() * 22);
                b.innerHTML = createPastelButterflySVG(size);

                const startX = originX + (Math.random() * 140 - 70);
                const startY = originY + (Math.random() * 30 - 15);
                b.style.left = startX + 'px';
                b.style.top = startY + 'px';

                const angle = (-Math.PI / 2) + (Math.random() * 1.8 - 0.9);
                const distMid = 120 + Math.random() * 140;
                const distEnd = 280 + Math.random() * 260;

                b.style.setProperty('--tx-mid', Math.cos(angle) * distMid + 'px');
                b.style.setProperty('--ty-mid', Math.sin(angle) * distMid + 'px');
                b.style.setProperty('--tx-end', (Math.cos(angle) * distEnd + (Math.random() * 100 - 50)) + 'px');
                b.style.setProperty('--ty-end', (Math.sin(angle) * distEnd - 80) + 'px');
                b.style.setProperty('--rot-mid', (Math.random() * 40 - 20) + 'deg');
                b.style.setProperty('--rot-end', (Math.random() * 60 - 30) + 'deg');
                b.style.setProperty('--dur', (2.6 + Math.random() * 1.4) + 's');

                container.appendChild(b);
                setTimeout(() => b.remove(), 4200);
            }
        }

        function triggerButterfliesAndQuote() {
            const btn = document.getElementById('butterflies-surprise-btn');
            const rect = btn.getBoundingClientRect();
            const centerX = rect.left + rect.width / 2;
            const centerY = rect.top + rect.height / 2;

            // 1. Release flying pastel butterflies across the screen
            spawnButterflyBurst(centerX, centerY);

            // 2. Display & cycle through the 5 messages underneath
            const quoteBox = document.getElementById('dynamic-quote-box');
            const quoteCard = document.getElementById('dynamic-quote-card');
            const quoteText = document.getElementById('dynamic-quote-text');
            const quoteCounter = document.getElementById('dynamic-quote-counter');

            quoteBox.classList.remove('hidden');
            quoteText.textContent = memoSurpriseQuotes[currentQuoteIndex];
            quoteCounter.textContent = `${currentQuoteIndex + 1} / ${memoSurpriseQuotes.length} 🦋`;

            quoteCard.classList.remove('message-pop');
            void quoteCard.offsetWidth;
            quoteCard.classList.add('message-pop');

            currentQuoteIndex = (currentQuoteIndex + 1) % memoSurpriseQuotes.length;
        }

        function launchPinkConfetti() {
            if (typeof confetti !== 'function') return;

            const pinkPalette = ['#ff4d8d', '#ff85b3', '#ffb3ce', '#e11d68', '#ffffff'];

            confetti({
                particleCount: 80,
                spread: 75,
                origin: { y: 0.6 },
                colors: pinkPalette
            });

            setTimeout(() => {
                confetti({
                    particleCount: 50,
                    angle: 60,
                    spread: 55,
                    origin: { x: 0, y: 0.65 },
                    colors: pinkPalette
                });
                confetti({
                    particleCount: 50,
                    angle: 120,
                    spread: 55,
                    origin: { x: 1, y: 0.65 },
                    colors: pinkPalette
                });
            }, 280);
        }

        function spawnAmbientHearts() {
            const container = document.getElementById('hearts-bg-container');
            const items = ['🌸', '🦋', '💖', '✨', '💗'];

            for (let i = 0; i < 16; i++) {
                const el = document.createElement('div');
                el.className = 'ambient-heart select-none';
                el.textContent = items[i % items.length];
                el.style.fontSize = (14 + Math.random() * 10) + 'px';
                el.style.opacity = '0.55';
                el.style.left = Math.random() * 96 + 'vw';
                el.style.animationDuration = (9 + Math.random() * 8) + 's';
                el.style.animationDelay = (-Math.random() * 10) + 's';
                container.appendChild(el);
            }
        }

        let toastTimeout = null;
        function showToast(message) {
            const toast = document.getElementById('toast-notification');
            const msgEl = document.getElementById('toast-message');
            msgEl.textContent = message;

            toast.classList.remove('opacity-0', '-translate-y-4');
            toast.classList.add('opacity-100', 'translate-y-0');

            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.remove('opacity-100', 'translate-y-0');
                toast.classList.add('opacity-0', '-translate-y-4');
            }, 2500);
        }
    </script>
</body>
</html>
